DATABASE_URL=postgres://KULLANICI:PAROLA@HOST/VERITABANI?sslmode=verify-full
PORT=3000
SESSION_SECRET=
# Üretimde uygulamanın gerçek HTTPS adresi kullanılmalıdır.
APP_BASE_URL=http://localhost:5173
# Üretimde zorunlu: Resend anahtarını güvenli ortam değişkeninde saklayın.
RESEND_API_KEY=
EMAIL_FROM=giris@auth.todap.org
SEED_ADMIN_EMAIL=admin@example.com
# Seed tabloları temizler; yalnızca geliştirme veritabanında "true" yapın.
ALLOW_SEED=false
# Testler yalnızca bu veritabanına bağlanır; adı "test" ile bitmelidir. Geliştirme veritabanını kullanmaz.
TEST_DATABASE_URL=postgres://postgres@localhost:5433/todap_test
# Web geliştirme sunucusunun /api isteklerini göndereceği adres (isteğe bağlı; varsayılan http://localhost:3000).
# API_PROXY_TARGET=http://localhost:3000
