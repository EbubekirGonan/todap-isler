{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node-pg-migrate up -m migrations --envPath ../.env",
    "migrate:down": "node-pg-migrate down -m migrations --envPath ../.env",
    "seed": "tsx seed/seed.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Todap iş paylaşım uygulaması API sunucusu",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
